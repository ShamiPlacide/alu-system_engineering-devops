#!/usr/bin/env bash
# Configure Nginx server so that /redirect_me redirects to another page with 301

# Update package list
apt-get update

# Install nginx
apt-get install -y nginx

# Start nginx service
service nginx start

# Configure the redirect by adding location block to default site
sed -i '/listen 80 default_server;/a\\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' /etc/nginx/sites-available/default

# Test nginx configuration
nginx -t

# Reload nginx to apply changes
service nginx reload
