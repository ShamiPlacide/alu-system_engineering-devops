#!/usr/bin/env bash
# Configure Nginx server to have a custom 404 page that contains "Ceci n'est pas une page"

# Update package list
apt-get update

# Install nginx
apt-get install -y nginx

# Start nginx service
service nginx start

# Create custom 404 page
echo "Ceci n'est pas une page" > /var/www/html/custom_404.html

# Configure the redirect by adding location block to default site (from previous task)
sed -i '/listen 80 default_server;/a\\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' /etc/nginx/sites-available/default

# Add custom 404 error page configuration
sed -i '/listen 80 default_server;/a\\terror_page 404 /custom_404.html;\n\tlocation = /custom_404.html {\n\t\troot /var/www/html;\n\t\tinternal;\n\t}' /etc/nginx/sites-available/default

# Test nginx configuration
nginx -t

# Reload nginx to apply changes
service nginx reload
