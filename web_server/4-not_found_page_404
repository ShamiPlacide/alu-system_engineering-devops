#!/usr/bin/env bash
# Script that configures a new Ubuntu machine with nginx and custom 404 page
# Requirements:
# - Install nginx
# - Nginx listening on port 80
# - Root page contains "Holberton School"
# - Custom 404 page contains "Ceci n'est pas une page"
# - 404 page returns HTTP 404 error code
# - Cannot use systemctl for restarting nginx

# Check if running as root
if [[ $EUID -ne 0 ]]; then
   echo "This script must be run as root or with sudo" 
   exit 1
fi

# Update package list
apt-get update -y

# Install nginx
apt-get install -y nginx

# Create the main index.html page
echo "Holberton School for the win!" | tee /var/www/html/index.html > /dev/null

# Create custom 404 error page
echo "Ceci n'est pas une page" | tee /var/www/html/404.html > /dev/null

# Configure nginx with custom 404 page
# Create a new server configuration that includes the custom 404 page
{
    echo "server {"
    echo "    listen 80 default_server;"
    echo "    listen [::]:80 default_server;"
    echo ""
    echo "    root /var/www/html;"
    echo "    index index.html index.htm index.nginx-debian.html;"
    echo ""
    echo "    server_name _;"
    echo ""
    echo "    # Custom 404 error page"
    echo "    error_page 404 /404.html;"
    echo "    location = /404.html {"
    echo "        root /var/www/html;"
    echo "        internal;"
    echo "    }"
    echo ""
    echo "    location / {"
    echo "        try_files \$uri \$uri/ =404;"
    echo "    }"
    echo "}"
} > /etc/nginx/sites-available/default

# Test nginx configuration
nginx -t

# Start nginx service (using service command instead of systemctl)
service nginx start

# Enable nginx to start on boot
update-rc.d nginx enable

# Restart nginx to load the new configuration (using service command)
service nginx restart
